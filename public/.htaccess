# 1. Enable Rewrite Engine for SPA routing (React / Wouter)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# 2. Hostinger LiteSpeed Fallback Resource
FallbackResource /index.html

# 3. Hostinger Custom 404 Error Document Fallback
ErrorDocument 404 /index.html
